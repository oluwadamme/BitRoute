# Copy this file to .env and fill in real values. .env is gitignored.
# Keys use double underscore (__) to map onto nested configuration:
# Jwt__AccessTokenMinutes maps to configuration key Jwt:AccessTokenMinutes.

# JWT (Phase 2)
Jwt__Issuer=bitroute
Jwt__Audience=bitroute-clients
Jwt__SigningKey=replace-with-a-long-random-secret-at-least-32-bytes
Jwt__AccessTokenMinutes=60
Jwt__RefreshTokenDays=30

# PostgreSQL (Phase 3)
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=bitroute;Username=bitroute;Password=bitroute

# Redis (Phase 2 refresh-token store)
ConnectionStrings__Redis=localhost:6379

# Stripe (Phase 4)
Stripe__SecretKey=
Stripe__WebhookSecret=
